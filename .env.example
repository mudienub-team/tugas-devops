# --- Aplikasi ---
NODE_ENV=production
APP_PORT=3000
APP_HOSTNAME=0.0.0.0

# --- Database (dipakai docker-compose) ---
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=todos_db
DB_PORT=3306

# --- Koneksi dari luar container (npm run dev, prisma db push, build) ---
DATABASE_URL="mysql://root:root@localhost:3306/todos_db"

# APP_VERSION tidak diisi di sini: diambil otomatis dari package.json
